# Container environment file for AB Tech Tracker.
# Copy this file to deploy/container.env and fill in the values.
# deploy/container.env is gitignored; do not commit the filled-in copy.
#
# This file is loaded by every container (web, ts, email, slack).
# DATABASE_URL and SPHINX_* are set per-service in compose.yml and
# do not need to appear here.

# Rails Environment
# =================
RAILS_ENV=production

# Rails Master Key
# ================
# Copy from config/credentials/production.key (or config/master.key for staging).
# Generate a new one with: podman run --rm abtech-tracker:latest rails credentials:edit
RAILS_MASTER_KEY=

# Rails Relative URL Root
# =======================
# Set to a subdirectory (e.g. /tracker) if serving behind a reverse proxy prefix.
RAILS_RELATIVE_URL_ROOT=/

# Rails Serve Static Files
# ========================
# Set to "true" only if no reverse proxy (Nginx etc.) is serving /public.
# When false, precompiled assets are synced to the `public` named volume
# via the docker-sync-assets-entrypoint so Nginx can serve them directly.
RAILS_SERVE_STATIC_FILES=false

# Action Mailer Default URL Host
# ==============================
ACTION_MAILER_DEFAULT_URL_HOST=tracker.abtech.org

# Puma Thread Counts
# ==================
RAILS_MIN_THREADS=5
RAILS_MAX_THREADS=5

# Andrew SAML SP Configuration
# ============================
# Paths inside the container; bind-mount the cert and key files or use
# podman secrets / Docker secrets and adjust these paths accordingly.
SAML_ANDREW_SP_CERTIFICATE_PATH=/run/secrets/saml_sp_cert
SAML_ANDREW_SP_PRIVATE_KEY_PATH=/run/secrets/saml_sp_key
SAML_ANDREW_SP_ENTITY_ID=https://www-01.abtech.org/shibboleth
SAML_ANDREW_SP_ISSUER=https://tracker.abtech.org/shibboleth
SAML_ANDREW_SP_CUSTOM_ACS_URL=https://tracker.abtech.org/Shibboleth.sso/SAML2/POST

# Puppeteer / Grover (PDF generation)
# ====================================
# Chromium runs inside the container as a non-root user and requires
# the --no-sandbox flag. Add a Rails initializer at
# config/initializers/grover.rb with:
#
#   Grover.configure do |config|
#     config.options = {
#       launch_args: ['--no-sandbox', '--disable-setuid-sandbox']
#     }
#   end
