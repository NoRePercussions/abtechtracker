# Compose variable substitution — copy to .env and fill in values.
# .env is gitignored; do not commit the filled-in copy.

# Password for the MariaDB `tracker` user.
# Must match MARIADB_PASSWORD in the db service and the password
# component of DATABASE_URL in deploy/container.env.
DB_PASSWORD=change_me

# Host port to expose the web service on (default: 3000).
# PORT=3000
